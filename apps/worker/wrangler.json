{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "publishing-platform-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "publishing-platform-local",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "publishing-delivery-local" },
      { "binding": "DELIVERY_DLQ", "queue": "publishing-delivery-dlq-local" }
    ],
    "consumers": [
      {
        "queue": "publishing-delivery-local",
        "max_retries": 3,
        "dead_letter_queue": "publishing-delivery-dlq-local"
      }
    ]
  },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "publishing-artifacts-local" }
  ],
  "triggers": { "crons": ["*/15 * * * *", "7 * * * *", "23 */6 * * *"] },
  "vars": {
    "CAPACITY_BUDGETS": "{\"d1Rows\":70000,\"queueOperations\":7000,\"r2Bytes\":7516192768}",
    "ENABLED_ADAPTERS": ""
  },
  "env": {
    "staging": {
      "name": "publishing-platform-staging",
      "d1_databases": [
        {
          "binding": "LEDGER",
          "database_name": "publishing-platform-staging",
          "database_id": "00000000-0000-0000-0000-000000000002"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "DELIVERY_QUEUE", "queue": "publishing-delivery-staging" },
          { "binding": "DELIVERY_DLQ", "queue": "publishing-delivery-dlq-staging" }
        ],
        "consumers": [
          {
            "queue": "publishing-delivery-staging",
            "max_retries": 3,
            "dead_letter_queue": "publishing-delivery-dlq-staging"
          }
        ]
      },
      "r2_buckets": [
        { "binding": "ARTIFACTS", "bucket_name": "publishing-artifacts-staging" }
      ],
      "triggers": { "crons": ["*/15 * * * *", "7 * * * *", "23 */6 * * *"] },
      "vars": {
        "CAPACITY_BUDGETS": "{\"d1Rows\":70000,\"queueOperations\":7000,\"r2Bytes\":7516192768}",
        "ENABLED_ADAPTERS": ""
      }
    },
    "production": {
      "name": "publishing-platform-production",
      "d1_databases": [
        {
          "binding": "LEDGER",
          "database_name": "publishing-platform-production",
          "database_id": "00000000-0000-0000-0000-000000000003"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "DELIVERY_QUEUE", "queue": "publishing-delivery-production" },
          { "binding": "DELIVERY_DLQ", "queue": "publishing-delivery-dlq-production" }
        ],
        "consumers": [
          {
            "queue": "publishing-delivery-production",
            "max_retries": 3,
            "dead_letter_queue": "publishing-delivery-dlq-production"
          }
        ]
      },
      "r2_buckets": [
        { "binding": "ARTIFACTS", "bucket_name": "publishing-artifacts-production" }
      ],
      "triggers": { "crons": ["*/15 * * * *", "7 * * * *", "23 */6 * * *"] },
      "vars": {
        "CAPACITY_BUDGETS": "{\"d1Rows\":70000,\"queueOperations\":7000,\"r2Bytes\":7516192768}",
        "ENABLED_ADAPTERS": ""
      }
    }
  }
}
